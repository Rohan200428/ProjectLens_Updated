# Docker Compose reads this after you copy it to .env.
# For Maven/Java, export these variables in your shell as described in README.
DB_URL=jdbc:mysql://127.0.0.1:3308/projectlens_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=projectlens
DB_PASSWORD=replace-with-a-local-development-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
SERVER_PORT=8080
REVIEW_THRESHOLD=70
OVERLAP_MEDIUM=0.25
OVERLAP_HIGH=0.55
SEED_ENABLED=true
SEED_PASSWORD=ProjectLens123!

# Optional backend-only AI evaluation. Never place the key in frontend files.
EVALUATION_MODE=AUTO
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=12
